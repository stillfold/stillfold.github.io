# Read by Cloudflare Pages when it serves the site. Not a page.

# The project's own pages.dev addresses hold a second copy of the site.
# Keep them out of search: stillfold.dev is the only address to index.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Astro names these files after their contents, so a changed file gets a
# new name and an old one can be kept by browsers for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
