---
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Facets from '../../components/Facets.astro';
import PlayLink from '../../components/PlayLink.astro';
import Qr from '../../components/Qr.astro';
import Reel from '../../components/Reel.astro';
import Faq from '../../components/Faq.astro';
import Foot from '../../components/Foot.astro';
import { apps, organization, site } from '../../data/site.js';

import icon from '../../assets/pickaxeplanet/icon.png';
import frenzy from '../../assets/pickaxeplanet/frenzy.png';
import guardian from '../../assets/pickaxeplanet/guardian.png';
import crystal from '../../assets/pickaxeplanet/crystal-caverns.png';
import dock from '../../assets/pickaxeplanet/fishing-dock.png';
import dive from '../../assets/pickaxeplanet/fishing-dive.png';
import cart from '../../assets/pickaxeplanet/mine-cart.png';

const app = apps.pickaxe;
const url = new URL(app.path, site.url).href;
const title = 'Pickaxe Planet: Idle Miner, a free idle mining game for Android';
const description =
  'Pickaxe Planet is a free idle mining game for Android. Tap to dig to the core, forge 15 tiers of pickaxes, break Guardians, collect miners and pets, and go fishing in underground lakes.';

// What lies past the first Core is a surprise the game keeps. Nothing on
// this page names it, the same rule as the Play listing.
const does = [
  {
    t: 'Tap, dig, Frenzy',
    d: 'An idle clicker at heart: chain taps into a combo, hit 100 and unleash a Frenzy. Your miner digs by itself while you are away.',
  },
  {
    t: 'Forge legendary pickaxes',
    d: 'Fifteen tiers, from Wooden to Infinity, each forged from ore you dug yourself, with six elements to level: Fire, Frost, Lightning, Void, Nature and Star.',
  },
  {
    t: 'Boss fights every 50 metres',
    d: 'A stone Guardian seals the shaft. Break it before time runs out, or upgrade and come back stronger.',
  },
  {
    t: 'A whole fishing game underground',
    d: 'More than 150 kinds of fish across hidden lakes and an underground river, a Fish Book to fill, tackle to upgrade and lake bosses to fight.',
  },
  {
    t: 'Prestige and come back stronger',
    d: 'Resurface with relics that make every future dive stronger: an incremental game that keeps opening up.',
  },
  {
    t: 'Miners and pets to collect',
    d: 'Cat, dog, fox, bunny, frog, panda, mole, penguin, axolotl, robot and more, with pets that dig beside you.',
  },
  {
    t: 'Something new every day',
    d: 'Daily rewards and quests, achievements, a weekly Guardian Arena, treasure maps, mine cart rides, holiday fishing events and a monthly Mining Pass.',
  },
];

const layers = [
  'Topsoil',
  'Stone',
  'Deepslate',
  'Frost Caves',
  'Fungal Grotto',
  'Magma Depths',
  'Crystal Caverns',
  'Ancient City',
  'The Abyss',
  'The Core',
];

const shots = [
  { src: frenzy, title: 'Frenzy', alt: 'Pickaxe Planet screenshot: a Frenzy, the miner digging at full speed', text: 'Chain 100 taps into a combo and the miner lets loose.' },
  { src: guardian, title: 'Guardians', alt: 'Pickaxe Planet screenshot: fighting a stone Guardian that seals the mine shaft', text: 'Every 50 metres one seals the shaft, on a timer.' },
  { src: crystal, title: 'Crystal Caverns', alt: 'Pickaxe Planet screenshot: mining in the Crystal Caverns', text: 'The seventh of ten layers on the way down.' },
  { src: dock, title: 'Fishing', alt: 'Pickaxe Planet screenshot: fishing from the dock at an underground lake', text: 'Hidden lakes and an underground river, with a boss in every lake.' },
  { src: dive, title: 'Under the water', alt: 'Pickaxe Planet screenshot: the hook among the fish under the water', text: 'More than 150 kinds of fish to find.' },
  { src: cart, title: 'Mine cart rides', alt: 'Pickaxe Planet screenshot: a mine cart ride', text: 'A ride along the rails, picking up coins.' },
];

const faq = [
  { q: 'Is Pickaxe Planet free?', a: 'Yes. It is free to play. Diamonds can be earned in every part of the game; buying them is a shortcut, never a requirement.' },
  { q: 'Does it have ads?', a: 'Only ones you choose to watch for a bonus. There are no forced ads.' },
  { q: 'Does my progress carry over to a new phone?', a: 'Yes, if you sign in with Google Play Games: your save is kept in the cloud.' },
  { q: 'What kind of game is it?', a: 'An idle game, a clicker and an incremental game about mining: it plays in short sessions, and your miner keeps digging between them.' },
  { q: 'Is it on iPhone?', a: 'No. It is an Android game for now.' },
];

const shot = async (src) => new URL((await getImage({ src, width: 1080, format: 'jpg' })).src, site.url).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': ['VideoGame', 'MobileApplication'],
    name: app.fullName,
    alternateName: app.name,
    description:
      'A free idle mining game for Android. Tap to dig to the core, forge 15 tiers of pickaxes, break Guardians, collect miners and pets, and go fishing in underground lakes.',
    url,
    image: new URL('/pickaxeplanet/img/feature.jpg', site.url).href,
    screenshot: [await shot(frenzy), await shot(guardian), await shot(dock)],
    operatingSystem: 'Android 7.0 and later',
    applicationCategory: 'GameApplication',
    genre: ['Idle', 'Clicker', 'Incremental', 'Simulation'],
    gamePlatform: 'Android',
    playMode: 'SinglePlayer',
    inLanguage: 'en',
    installUrl: `https://play.google.com/store/apps/details?id=${app.id}`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
    author: organization,
    publisher: organization,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'stillfold', item: site.url },
      { '@type': 'ListItem', position: 2, name: app.name, item: url },
    ],
  },
];
---

<Base title={title} description={description} image="/pickaxeplanet/img/feature.jpg" schema={schema} over="game">
  <main id="main">
    <header class="panel panel--game lead" data-paper="game">
      <Facets pattern="a" />
      <div class="panel__in two">
        <div>
          <p class="kicker">Idle mining game &middot; Android &middot; Free</p>
          <div class="title-row">
            <Picture src={icon} formats={['avif', 'webp']} widths={[96, 192]} sizes="5.5rem" alt="" />
            <h1 class="title title--game">Pickaxe Planet<span class="vh">: </span><small>Idle Miner</small></h1>
          </div>
          <p class="lede">Dig to the core of every world.</p>
          <p class="text">
            <strong>Pickaxe Planet is a free idle mining game for Android.</strong> Dig straight down through a blocky
            world, one tap at a time. Your miner keeps digging on its own, every tap hits harder, and every metre pays
            more. Mine ore, forge better pickaxes, break the Guardians and see how deep you can go.
          </p>
          <p class="cta cta--top">
            <PlayLink id={app.id} where="game_top" />
            <a class="more" href="#what-you-do">What you do in it</a>
          </p>
          <p class="fine">Free to play on Android phones, tablets and foldables (Android 7 and later). No forced ads.</p>
        </div>
        <div class="shots">
          <div class="shot">
            <Picture src={crystal} formats={['avif', 'webp']} widths={[240, 400, 640]} sizes="(max-width: 56rem) 40vw, 18rem" alt="Mining in the Crystal Caverns" />
          </div>
          <div class="shot">
            <Picture src={frenzy} formats={['avif', 'webp']} widths={[240, 400, 640]} sizes="(max-width: 56rem) 40vw, 18rem" alt="A Frenzy: the miner digging at full speed" />
          </div>
          <div class="shot">
            <Picture src={cart} formats={['avif', 'webp']} widths={[240, 400, 640]} sizes="(max-width: 56rem) 40vw, 18rem" alt="A mine cart ride" />
          </div>
        </div>
      </div>
    </header>

    <section class="panel panel--game panel--deeper fold" id="what-you-do" data-fold data-paper="game">
      <Facets pattern="b" />
      <div class="panel__in">
        <h2 class="title title--game title--mid">What you do in Pickaxe Planet</h2>
        <ol class="does">
          {
            does.map((f) => (
              <li>
                <h3>{f.t}</h3>
                <p>{f.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="panel panel--game panel--shaft fold" id="layers" data-fold data-depth data-paper="game">
      <Facets pattern="c" />
      <div class="panel__in">
        <h2 class="title title--game title--mid">Ten layers down to the Core</h2>
        <p class="text">
          Every 100 metres the rock changes, with new colours, blocks and ores. At 1000 metres, the world's god is
          waiting.
        </p>
        <div class="shaft">
          <p class="shaft__depth" aria-hidden="true"><b data-depth-read>0</b> m</p>
          <ol class="shaft__layers">
            {layers.map((name, i) => <li data-layer style={`--i:${i}`}><span>{i * 100} m</span>{name}</li>)}
          </ol>
        </div>
      </div>
    </section>

    <section class="panel panel--paper fold" id="screenshots" data-fold data-paper="paper">
      <Facets pattern="a" />
      <div class="panel__in">
        <h2 class="title title--mid">Screenshots</h2>
        <Reel items={shots} />
      </div>
    </section>

    <section class="panel panel--game fold" id="questions" data-fold data-paper="game">
      <Facets pattern="b" />
      <div class="panel__in">
        <h2 class="title title--game title--mid">Questions people ask</h2>
        <Faq items={faq} />
        <div class="closing">
          <div>
            <p class="lede">See how deep you can go.</p>
            <p class="cta">
              <PlayLink id={app.id} where="game_end" />
              <a class="more" href="privacy/">Privacy policy</a>
            </p>
            <p class="fine">Free to play. No forced ads.</p>
          </div>
          <Qr id={app.id} where="game" name={app.name} />
        </div>
      </div>
    </section>
  </main>
  <Foot />
</Base>
